# ── Server ──────────────────────────────────────────────
PORT=8000
ENVIRONMENT=development
FRONTEND_URL=http://localhost:5173

# ── JWT Auth ────────────────────────────────────────────
JWT_SECRET_KEY=change-this-to-a-random-secret-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
DEMO_USERNAME=admin
DEMO_PASSWORD=changeme123

# ── OpenRouter LLM API (same as Node backend) ────────────
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ── Agent Models (mirrors Node config.js) ────────────────
FILTER_AGENT_MODEL=meta-llama/llama-3.3-70b-instruct
GENERATOR_AGENT_MODEL=anthropic/claude-3-haiku
EVALUATOR_AGENT_MODEL=google/gemini-2.0-flash-001

# ── Hugging Face Embeddings (NEW — replaces Gemini embeddings) ──
HF_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ── Vector Store ──────────────────────────────────────────
# 'chroma' for local dev (no API key needed), 'pinecone' for prod
VECTOR_STORE=chroma
CHROMA_PERSIST_DIR=./chroma_db
CHROMA_COLLECTION_NAME=sentinel-docs

# Only needed if VECTOR_STORE=pinecone
PINECONE_API_KEY=
PINECONE_INDEX_NAME=sentinel-docs
